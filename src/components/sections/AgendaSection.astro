---
import { site } from "../../data/site";
import agendaFondo from "../../assets/agenda-fondo.webp";
---

<div class="section-block" id="agenda">
<section class="agenda-hero" aria-labelledby="agenda-hero-title">
  <img
    class="agenda-hero-bg"
    src={agendaFondo.src}
    width={agendaFondo.width}
    height={agendaFondo.height}
    alt="Dra. Jazmín Álvarez sonriendo en su consultorio"
    loading="lazy"
  />
  <div class="agenda-hero-copy">
    <p class="agenda-hero-eyebrow">Agenda</p>
    <h1 id="agenda-hero-title">Agenda tu <em>valoración</em></h1>
    <p class="agenda-hero-text">
      Da el primer paso para recuperar tu cabello, realzar tu belleza y sentirte mejor.
    </p>
    <ul class="agenda-hero-features">
      <li>
        <span class="agenda-hero-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24"><rect x="3.5" y="5.5" width="17" height="15" rx="2.5" /><path d="M8 3.5v4M16 3.5v4M3.5 10h17M8 14h2M12 14h2M8 17h2" /></svg>
        </span>
        Elige fecha<br /> y horario
      </li>
      <li>
        <span class="agenda-hero-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M4.5 19.5l1.2-3.6A8 8 0 1 1 8.4 18.6z" /><path d="M9.2 8.6c.3 2.6 2.4 5 5.2 5.9l1.1-1.2-1.6-.9-.8.7c-1-.5-1.9-1.4-2.4-2.4l.7-.8-.9-1.6z" /></svg>
        </span>
        Confirma<br /> por WhatsApp
      </li>
      <li>
        <span class="agenda-hero-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8.5" /><path d="m8.2 12.2 2.6 2.6 5-5.2" /></svg>
        </span>
        Asesoría<br /> personalizada
      </li>
    </ul>
    <a class="button button-gold button-large agenda-hero-button" href="#agenda-calendario">
      <svg class="button-icon" viewBox="0 0 24 24" aria-hidden="true">
        <rect x="3.5" y="5.5" width="17" height="15" rx="2.5" />
        <path d="M8 3.5v4M16 3.5v4M3.5 10h17" />
      </svg>
      Agendar mi valoración
      <span aria-hidden="true">→</span>
    </a>
  </div>
</section>

<div class="agenda-page" id="agenda-calendario">

  <section
    class="agenda-layout"
    data-agenda
    data-whatsapp-number={site.whatsappNumber}
  >
    <div class="calendar-card">
      <div class="calendar-header">
        <button type="button" aria-label="Mes anterior" data-calendar-prev>←</button>
        <h2 data-calendar-title>Calendario</h2>
        <button type="button" aria-label="Mes siguiente" data-calendar-next>→</button>
      </div>
      <div class="calendar-weekdays" aria-hidden="true">
        <span>Lun</span><span>Mar</span><span>Mié</span><span>Jue</span><span>Vie</span><span>Sáb</span><span>Dom</span>
      </div>
      <div class="calendar-grid" data-calendar-grid aria-label="Selecciona una fecha"></div>
      <p class="calendar-help">Solo se muestran los días habilitados por la administradora. La fecha se confirma por WhatsApp.</p>
    </div>

    <div class="agenda-options">
      <div class="time-picker">
        <p class="eyebrow">Horarios disponibles</p>
        <h2>Selecciona una hora</h2>
        <div class="time-grid" role="group" aria-label="Horarios disponibles" data-time-grid></div>
        <p class="time-empty" data-time-empty>Primero selecciona una fecha disponible.</p>
      </div>

      <div class="appointment-summary">
        <h2>Resumen de tu cita</h2>
        <dl>
          <div><dt>Fecha</dt><dd data-summary-date>—</dd></div>
          <div><dt>Hora</dt><dd data-summary-time>—</dd></div>
          <div><dt>Tipo de valoración</dt><dd>Valoración inicial</dd></div>
        </dl>
        <div class="appointment-patient-fields">
          <label><span>Nombre</span><input type="text" autocomplete="name" data-patient-name required /></label>
          <label><span>WhatsApp</span><input type="tel" autocomplete="tel" data-patient-phone required /></label>
        </div>
        <button class="button button-dark button-large" type="button" data-agenda-continue disabled>
          Apartar 30 min y continuar
        </button>
        <p class="whatsapp-confirmation">El horario se apartará durante 30 minutos mientras confirmas por WhatsApp.</p>
      </div>
    </div>
  </section>
</div>
</div>

<script>
  import {
    createDemoHold,
    getDemoAppointments,
    getDemoSettings,
  } from "../../scripts/demoStore";

  const locale = "es-MX";

  document.querySelectorAll<HTMLElement>("[data-agenda]").forEach((agenda) => {
    const settings = getDemoSettings();
    const title = agenda.querySelector<HTMLElement>("[data-calendar-title]");
    const grid = agenda.querySelector<HTMLElement>("[data-calendar-grid]");
    const previous = agenda.querySelector<HTMLButtonElement>("[data-calendar-prev]");
    const next = agenda.querySelector<HTMLButtonElement>("[data-calendar-next]");
    const timeGrid = agenda.querySelector<HTMLElement>("[data-time-grid]");
    const timeEmpty = agenda.querySelector<HTMLElement>("[data-time-empty]");
    const dateSummary = agenda.querySelector<HTMLElement>("[data-summary-date]");
    const timeSummary = agenda.querySelector<HTMLElement>("[data-summary-time]");
    const continueButton = agenda.querySelector<HTMLButtonElement>("[data-agenda-continue]");
    const patientName = agenda.querySelector<HTMLInputElement>("[data-patient-name]");
    const patientPhone = agenda.querySelector<HTMLInputElement>("[data-patient-phone]");
    const today = new Date();
    today.setHours(0, 0, 0, 0);
    const lastDate = new Date(today);
    lastDate.setDate(lastDate.getDate() + 90);
    let viewDate = new Date(today.getFullYear(), today.getMonth(), 1);
    let selectedDate: Date | null = null;
    let selectedTime = "";

    const toDateKey = (date: Date) => [
      date.getFullYear(),
      String(date.getMonth() + 1).padStart(2, "0"),
      String(date.getDate()).padStart(2, "0"),
    ].join("-");

    const formatDate = (date: Date) => new Intl.DateTimeFormat(locale, {
      weekday: "long",
      day: "numeric",
      month: "long",
      year: "numeric",
    }).format(date);

    const updateSummary = () => {
      if (dateSummary) dateSummary.textContent = selectedDate ? formatDate(selectedDate) : "—";
      if (timeSummary) timeSummary.textContent = selectedTime || "—";
      if (continueButton) {
        continueButton.disabled = !(
          selectedDate &&
          selectedTime &&
          patientName?.value.trim() &&
          patientPhone?.value.trim()
        );
      }
    };

    const renderTimes = () => {
      if (!timeGrid || !timeEmpty) return;
      timeGrid.replaceChildren();
      if (!selectedDate) {
        timeEmpty.hidden = false;
        timeEmpty.textContent = "Primero selecciona una fecha disponible.";
        return;
      }

      const dateKey = toDateKey(selectedDate);
      const occupied = getDemoAppointments()
        .filter((appointment) => appointment.date === dateKey)
        .map((appointment) => appointment.time);
      const times = settings.schedule[String(selectedDate.getDay())]?.times ?? [];
      timeEmpty.hidden = times.length > 0;
      timeEmpty.textContent = times.length
        ? ""
        : "No existen horarios configurados para este día.";

      times.forEach((time) => {
        const button = document.createElement("button");
        button.type = "button";
        button.textContent = time;
        button.dataset.time = time;
        button.disabled = occupied.includes(time);
        button.classList.toggle("selected", selectedTime === time);
        button.setAttribute(
          "aria-label",
          occupied.includes(time) ? `${time}, horario no disponible` : `Seleccionar ${time}`,
        );
        button.addEventListener("click", () => {
          selectedTime = time;
          timeGrid.querySelectorAll("button").forEach((item) => {
            item.classList.toggle("selected", item === button);
          });
          updateSummary();
        });
        timeGrid.append(button);
      });
    };

    const selectDate = (date: Date, button: HTMLButtonElement) => {
      selectedDate = date;
      selectedTime = "";
      grid?.querySelectorAll("button").forEach((item) => item.classList.remove("selected"));
      button.classList.add("selected");
      renderTimes();
      updateSummary();
    };

    const renderCalendar = () => {
      if (!grid || !title) return;
      title.textContent = new Intl.DateTimeFormat(locale, { month: "long", year: "numeric" }).format(viewDate);
      title.textContent = title.textContent.charAt(0).toUpperCase() + title.textContent.slice(1);
      grid.replaceChildren();

      const firstDay = new Date(viewDate.getFullYear(), viewDate.getMonth(), 1);
      const leadingDays = (firstDay.getDay() + 6) % 7;
      const startDate = new Date(firstDay);
      startDate.setDate(firstDay.getDate() - leadingDays);

      for (let index = 0; index < 42; index += 1) {
        const date = new Date(startDate);
        date.setDate(startDate.getDate() + index);
        date.setHours(0, 0, 0, 0);
        const button = document.createElement("button");
        const isCurrentMonth = date.getMonth() === viewDate.getMonth();
        const daySchedule = settings.schedule[String(date.getDay())];
        const unavailable =
          date < today ||
          date > lastDate ||
          !daySchedule?.enabled ||
          daySchedule.times.length === 0;
        const isSelected = selectedDate?.getTime() === date.getTime();
        button.type = "button";
        button.textContent = String(date.getDate());
        button.className = isCurrentMonth ? "" : "outside-month";
        button.disabled = unavailable;
        button.setAttribute("aria-label", formatDate(date));
        if (isSelected) button.classList.add("selected");
        button.addEventListener("click", () => selectDate(date, button));
        grid.append(button);
      }

      if (previous) {
        previous.disabled = viewDate.getFullYear() === today.getFullYear() && viewDate.getMonth() === today.getMonth();
      }
      if (next) {
        next.disabled = viewDate.getFullYear() === lastDate.getFullYear() && viewDate.getMonth() === lastDate.getMonth();
      }
    };

    previous?.addEventListener("click", () => {
      viewDate = new Date(viewDate.getFullYear(), viewDate.getMonth() - 1, 1);
      renderCalendar();
    });

    next?.addEventListener("click", () => {
      viewDate = new Date(viewDate.getFullYear(), viewDate.getMonth() + 1, 1);
      renderCalendar();
    });

    patientName?.addEventListener("input", updateSummary);
    patientPhone?.addEventListener("input", updateSummary);

    continueButton?.addEventListener("click", () => {
      if (!selectedDate || !selectedTime || !patientName || !patientPhone) return;
      const dateKey = toDateKey(selectedDate);
      const hold = createDemoHold({
        date: dateKey,
        time: selectedTime,
        patientName: patientName.value.trim(),
        patientPhone: patientPhone.value.trim(),
      });
      if (!hold) {
        window.alert("Ese horario acaba de ser apartado. Por favor, selecciona otro.");
        selectedTime = "";
        renderTimes();
        updateSummary();
        return;
      }
      const text = [
        "Hola, me gustaría solicitar una valoración.",
        `Nombre: ${hold.patientName}`,
        `Teléfono: ${hold.patientPhone}`,
        `Fecha preferida: ${formatDate(selectedDate)}`,
        `Horario preferido: ${selectedTime}`,
        "Tipo: valoración inicial.",
        "El horario quedó apartado durante 30 minutos mientras confirmamos esta cita.",
      ].join("\n");
      window.open(
        `https://wa.me/${agenda.dataset.whatsappNumber}?text=${encodeURIComponent(text)}`,
        "_blank",
        "noopener,noreferrer",
      );
      selectedTime = "";
      renderTimes();
      updateSummary();
    });

    renderCalendar();
    renderTimes();
    updateSummary();
  });
</script>
