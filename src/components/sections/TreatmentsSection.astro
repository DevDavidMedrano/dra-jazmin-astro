---
import { withBase } from "../../data/paths";
/**
 * Bloque completo de Tratamientos (segunda imagen de diseño): portada
 * "Soluciones pensadas para ti", barra blanca con los 4 tratamientos y tarjetas.
 * Se usa igual en la página única y en /tratamientos/.
 */
import Icon from "../Icon.astro";
import InnerHero from "../InnerHero.astro";
import TreatmentStrip from "../TreatmentStrip.astro";
import HyperhidrosisSection from "./HyperhidrosisSection.astro";
import svcTricologia from "../../assets/servicios/consulta-tricologia.webp";
import svcInjerto from "../../assets/servicios/injerto-capilar.webp";
import svcBotox from "../../assets/servicios/botox-facial.webp";
import svcHiperhidrosis from "../../assets/servicios/hiperhidrosis.webp";
import svcLabios from "../../assets/servicios/relleno-labios.webp";
import svcDermapen from "../../assets/servicios/dermapen.webp";
import svcYellow from "../../assets/servicios/yellow-peel.webp";
import { services, site, treatments } from "../../data/site";

/** Fotografía de cada tarjeta; las que no tengan foto muestran el ícono. */
const cardPhotos: Record<string, { src: string; alt: string; position: string }> = {
  "restauracion-capilar": {
    src: "/images/doctora-consultorio-capilar.webp",
    alt: "Dra. Jazmín Álvarez en su consultorio junto al equipo de diagnóstico capilar",
    position: "55% 30%",
  },
  "medicina-estetica": {
    src: "/images/doctora-valoracion-facial.webp",
    alt: "Dra. Jazmín Álvarez valorando el rostro de una paciente",
    position: "50% 35%",
  },
  "rejuvenecimiento-facial": {
    src: "/images/doctora-tratamiento.webp",
    alt: "Dra. Jazmín Álvarez aplicando un tratamiento a una paciente",
    position: "center 30%",
  },
  "tratamientos-personalizados": {
    src: "/images/doctora-tricoscopia.webp",
    alt: "Dra. Jazmín Álvarez revisando el cuero cabelludo con un tricoscopio",
    position: "center 35%",
  },
};

/** Foto de cada servicio (sección "Lo que la doctora puede hacer por ti"). */
const servicePhotos: Record<string, ImageMetadata> = {
  "consulta-tricologia": svcTricologia,
  "injerto-capilar": svcInjerto,
  "botox-facial": svcBotox,
  hiperhidrosis: svcHiperhidrosis,
  "relleno-labios": svcLabios,
  dermapen: svcDermapen,
  "yellow-peel": svcYellow,
};

const cardLinks = ["Solicitar valoración", "Conocer opciones", "Solicitar información", "Agendar ahora"];
---

<div class="treatments-block" id="tratamientos">
  <InnerHero
    eyebrow="Tratamientos"
    title="Soluciones pensadas"
    titleAccent="para ti"
    description="Cada tratamiento comienza con una valoración médica personalizada para entender tus necesidades y definir opciones reales y seguras."
    image={withBase("/images/procedimiento-capilar.webp")}
    imageAlt="Dra. Jazmín Álvarez durante un procedimiento de restauración capilar"
    showActions
    benefits={[
      { icon: "shield", label: "Enfoque médico" },
      { icon: "leaf", label: "Resultados naturales" },
      { icon: "person", label: "Atención personalizada" },
      { icon: "star", label: "Tecnología de vanguardia" },
    ]}
  />

  <TreatmentStrip />

  <section class="treatment-catalog" id="catalogo" aria-labelledby="treatment-heading">
    <div class="section-heading compact-heading">
      <p class="eyebrow">Atención personalizada</p>
      <h2 id="treatment-heading">Encuentra un punto de partida para tu valoración</h2>
    </div>

    <div class="treatment-grid">
      {
        treatments.map((treatment, index) => {
          const photo = cardPhotos[treatment.id];
          const number = String(index + 1).padStart(2, "0");
          return photo ? (
            <article class="treatment-card treatment-card-photo" id={treatment.id}>
              <img src={withBase(photo.src)} alt={photo.alt} width="900" height="780" loading="lazy" style={`object-position: ${photo.position}`} />
              <div class="treatment-card-copy">
                <p class="card-index">{number}</p>
                <h3>{treatment.title}</h3>
                <p>{treatment.summary}</p>
                <a href={withBase("/#agenda")}>
                  {cardLinks[index]} <span aria-hidden="true">→</span>
                </a>
              </div>
            </article>
          ) : (
            <article class="treatment-card treatment-card-symbol" id={treatment.id}>
              <div class="treatment-symbol" aria-hidden="true">
                <Icon name={treatment.icon} />
              </div>
              <p class="card-index">{number}</p>
              <h3>{treatment.title}</h3>
              <p>{treatment.summary}</p>
              <a href={withBase("/#agenda")}>
                {cardLinks[index]} <span aria-hidden="true">→</span>
              </a>
            </article>
          );
        })
      }
    </div>
  </section>
  <section class="services-list" id="servicios" aria-labelledby="services-heading">
    <div class="services-head">
      <p class="services-eyebrow">Servicios</p>
      <h2 id="services-heading">Lo que la doctora puede hacer <em>por ti</em></h2>
      <p>Tratamientos médicos estéticos y capilares con resultados naturales, seguros y personalizados.</p>
    </div>
    <ul class="services-grid">
      {
        services.map((service) => {
          const photo = servicePhotos[service.id];
          const href = service.details
            ?? `https://wa.me/${site.whatsappNumber}?text=${encodeURIComponent(`Hola, me gustaría información sobre: ${service.title}`)}`;
          const external = !service.details;
          return (
            <li class="service-item">
              {photo && (
                <img class="service-photo" src={photo.src} alt="" width={photo.width} height={photo.height} loading="lazy" />
              )}
              <div class="service-body">
                <div class="service-title">
                  <span class="service-icon" aria-hidden="true"><Icon name={service.icon} /></span>
                  <h3>{service.title}</h3>
                </div>
                <p>{service.summary}</p>
                <a class="service-more" href={href} {...(external ? { target: "_blank", rel: "noreferrer" } : {})}>
                  Más información <span aria-hidden="true">→</span>
                </a>
              </div>
            </li>
          );
        })
      }
    </ul>
  </section>
  <HyperhidrosisSection />
</div>
