---
import { withBase } from "../../data/paths";
import InnerHero from "../InnerHero.astro";
---

<div class="blog-page" id="blog">
  <InnerHero
    eyebrow="Blog"
    title="Conoce más"
    titleAccent="sobre cada proceso"
    description="Información clara sobre restauración capilar y medicina estética para que llegues a tu valoración con mejores preguntas."
    image={withBase("/images/hero-doctor-06.webp")}
    imageAlt="Dra. Jazmín Álvarez explicando un tratamiento a una paciente con una tableta"
    imagePosition="40% 30%"
    lazy
    benefits={[
      { icon: "star", label: "Artículos" },
      { icon: "play", label: "Videos" },
      { icon: "people", label: "Dudas frecuentes" },
    ]}
  />

  <section class="blog-feed" aria-labelledby="blog-title">
    <div class="blog-grid" data-public-blog-grid>
      <article class="blog-empty-card" data-blog-empty>
        <span>✦</span>
        <h3>Próximamente habrá nuevas publicaciones</h3>
        <p>La doctora podrá compartir aquí fotografías, videos y artículos desde su dashboard.</p>
      </article>
    </div>
  </section>

</div>

<script>
  import {
    getDemoMediaById,
    getDemoPosts,
    getDemoSettings,
    getMediaObjectUrl,
    getVideoEmbedUrl,
  } from "../../scripts/demoStore";

  const settings = getDemoSettings();
  const name = document.querySelector<HTMLElement>("[data-blog-profile-name]");
  const headline = document.querySelector<HTMLElement>("[data-blog-profile-headline]");
  const biography = document.querySelector<HTMLElement>("[data-blog-profile-bio]");
  if (name) name.textContent = settings.profile.name;
  if (headline) headline.textContent = settings.profile.headline;
  if (biography) biography.textContent = settings.profile.biography;

  const grid = document.querySelector<HTMLElement>("[data-public-blog-grid]");
  const posts = getDemoPosts().filter((post) => post.published);
  if (grid && posts.length) {
    grid.replaceChildren();
    for (const post of posts) {
      const article = document.createElement("article");
      article.className = "blog-card";
      const media = document.createElement("div");
      media.className = "blog-card-media";

      if (post.mediaId) {
        const record = await getDemoMediaById(post.mediaId);
        if (record) {
          const url = getMediaObjectUrl(record);
          if (record.kind === "video") {
            const video = document.createElement("video");
            video.src = url;
            video.controls = true;
            video.preload = "metadata";
            media.append(video);
          } else {
            const image = document.createElement("img");
            image.src = url;
            image.alt = post.title;
            image.loading = "lazy";
            media.append(image);
          }
        }
      } else if (post.externalVideoUrl) {
        const embedUrl = getVideoEmbedUrl(post.externalVideoUrl);
        if (embedUrl) {
          const iframe = document.createElement("iframe");
          iframe.src = embedUrl;
          iframe.title = `Video: ${post.title}`;
          iframe.loading = "lazy";
          iframe.allow = "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture";
          iframe.allowFullscreen = true;
          media.append(iframe);
        }
      }

      if (!media.childElementCount) {
        const placeholder = document.createElement("span");
        placeholder.className = "blog-media-placeholder";
        placeholder.textContent = "Dra. Jazmín Álvarez";
        media.append(placeholder);
      }

      const copy = document.createElement("div");
      copy.className = "blog-card-copy";
      const meta = document.createElement("span");
      meta.className = "blog-card-meta";
      meta.textContent = new Intl.DateTimeFormat("es-MX", { dateStyle: "long" }).format(post.createdAt);
      const title = document.createElement("h3");
      title.textContent = post.title;
      const excerpt = document.createElement("strong");
      excerpt.textContent = post.excerpt;
      const body = document.createElement("p");
      body.textContent = post.body;
      copy.append(meta, title, excerpt, body);
      article.append(media, copy);
      grid.append(article);
    }
  }
</script>
