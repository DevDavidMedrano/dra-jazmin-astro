---
import { withBase } from "../../data/paths";
import InnerHero from "../InnerHero.astro";
const cases = [
  { id: "01", category: "capilar", title: "Restauración capilar" },
  { id: "02", category: "capilar", title: "Tratamiento capilar" },
  { id: "03", category: "estetica", title: "Medicina estética" },
];
---

<div class="section-block" id="resultados">
<InnerHero
  eyebrow="Resultados"
  title="Evolución documentada"
  titleAccent="con autorización"
  description="Casos reales que muestran la evolución de cada tratamiento, siempre con la autorización por escrito de cada paciente."
  image={withBase("/images/hero-doctor-03.webp")}
  imageAlt="Dra. Jazmín Álvarez revisando el cuero cabelludo de un paciente"
  imagePosition="45% 30%"
  lazy
  benefits={[
    { icon: "shield", label: "Fotos con consentimiento" },
    { icon: "person", label: "Casos individuales" },
    { icon: "star", label: "Seguimiento médico" },
  ]}
/>

<section class="results-gallery" aria-label="Galería clínica">

  <div class="result-filters" role="group" aria-label="Filtrar casos">
    <button class="result-filter active" type="button" data-result-filter="all">Todos</button>
    <button class="result-filter" type="button" data-result-filter="capilar">Restauración capilar</button>
    <button class="result-filter" type="button" data-result-filter="estetica">Medicina estética</button>
  </div>

  <div class="case-grid" data-case-grid>
    {
      cases.map((item) => (
        <article class="case-card" data-case-category={item.category}>
          <div class="case-title">
            <span>Caso {item.id}</span>
            <strong>{item.title}</strong>
          </div>
          <div class="case-comparison">
            <div>
              <div class="case-placeholder">
                <img src={withBase("/brand/dra-jazmin-mark.png")} alt="" width="197" height="387" loading="lazy" />
                <span>Imagen clínica autorizada</span>
              </div>
              <p>Antes</p>
            </div>
            <div>
              <div class="case-placeholder case-placeholder-after">
                <img src={withBase("/brand/dra-jazmin-mark.png")} alt="" width="197" height="387" loading="lazy" />
                <span>Imagen clínica autorizada</span>
              </div>
              <p>Después</p>
            </div>
          </div>
        </article>
      ))
    }
  </div>

  <div class="results-disclaimer">
    <span aria-hidden="true">i</span>
    <p>
      Los resultados pueden variar en cada paciente. Las imágenes definitivas
      deben contar con autorización y corresponder a casos clínicos reales.
    </p>
  </div>
</section>
</div>

<script>
  const filters = Array.from(
    document.querySelectorAll<HTMLButtonElement>("[data-result-filter]"),
  );
  const cases = Array.from(
    document.querySelectorAll<HTMLElement>("[data-case-category]"),
  );

  filters.forEach((filter) => {
    filter.addEventListener("click", () => {
      const selected = filter.dataset.resultFilter;

      filters.forEach((item) => item.classList.toggle("active", item === filter));
      cases.forEach((item) => {
        const visible = selected === "all" || item.dataset.caseCategory === selected;
        item.hidden = !visible;
      });
    });
  });
</script>
