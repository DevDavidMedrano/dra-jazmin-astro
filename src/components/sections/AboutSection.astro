---
import { withBase } from "../../data/paths";
import InnerHero from "../InnerHero.astro";
---

<div class="about-page" id="sobre-mi">
  <InnerHero
    class="about-hero"
    eyebrow="Sobre mí · Dra. Jazmín Álvarez"
    title="Ciencia, precisión"
    titleAccent="y atención cercana"
    description="Mi propósito es acompañarte con honestidad, cuidado y un plan diseñado para tus necesidades. La valoración es el espacio para escuchar lo que buscas y explicarte con claridad cada alternativa."
    image={withBase("/images/doctora-consultorio.webp")}
    imageAlt="Dra. Jazmín Álvarez realizando un tratamiento en su consultorio, junto a su título de Médico Cirujano y Partero"
    imagePosition="35% 30%"
    lazy
    showActions
    benefits={[
      { icon: "shield", label: "Atención ética" },
      { icon: "person", label: "Plan personalizado" },
      { icon: "leaf", label: "Seguimiento cercano" },
    ]}
  />

  <section class="about-note">
    <p class="eyebrow">La consulta</p>
    <h2>Un espacio para entender tu caso antes de elegir un tratamiento.</h2>
    <p>
      Revisamos antecedentes, objetivos y expectativas para definir un plan
      coherente contigo. Cuando una opción no es adecuada, también es importante
      decirlo con claridad.
    </p>
  </section>
</div>

<script>
  import { getDemoSettings } from "../../scripts/demoStore";

  // La biografía se puede editar desde el panel de administración.
  const biography = document.querySelector<HTMLElement>(".about-hero .inner-hero-copy > h1 + p");
  const text = getDemoSettings().profile.biography;
  if (biography && text) biography.textContent = text;
</script>

