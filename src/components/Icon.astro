---
/** Íconos de línea del sitio. Heredan el color del texto (currentColor). */
import type { IconName } from "../data/icons";

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className } = Astro.props;
---

<svg
  class:list={["icon", `icon-${name}`, className]}
  viewBox="0 0 48 48"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {name === "hair" && (
    <>
      <path d="M4 34c6-1.5 10-1.5 14 0M30 34c4-1.5 8-1.5 14 0" />
      <path d="M18 34c0-4 2.5-6 6-6s6 2 6 6c0 3.5-2.5 6-6 6s-6-2.5-6-6Z" />
      <path d="M24 28c0-8 2-15 8-22" />
      <path d="M24 40v4" />
    </>
  )}
  {name === "face" && (
    <>
      <path d="M14 20c0-8 4.5-13 10-13s10 5 10 13v5c0 9-5 15-10 15s-10-6-10-15v-5Z" />
      <path d="M14 19c4 0 9-2.5 12-7 2 3.5 5 6 8 7" />
      <path d="M19 25c1 .8 2.2.8 3 0M26 25c1 .8 2.2.8 3 0M21.5 33c1.6 1 3.4 1 5 0" />
      <path d="M10 22c-2 1-2 6 0 7M38 22c2 1 2 6 0 7" />
    </>
  )}
  {name === "syringe" && (
    <>
      <path d="m31 7 10 10M36 12l-4 4" />
      <path d="M33 14 14 33l-4-1-1-4 19-19 5 5Z" />
      <path d="m10 38-4 4M19 22l3 3M23 18l3 3" />
    </>
  )}
  {name === "lips" && (
    <>
      <path d="M5 24c5-6 10-10 14-10 2 0 3.5 1.5 5 1.5S27 14 29 14c4 0 9 4 14 10" />
      <path d="M5 24c6 7 12 10 19 10s13-3 19-10" />
      <path d="M5 24c8 2 13 2 19 0 6 2 11 2 19 0" />
    </>
  )}
  {name === "pen" && (
    <>
      <path d="m34 6 8 8-20 20-9 1 1-9L34 6Z" />
      <path d="m29 11 8 8M14 34l-8 8M7 30l4 4" />
    </>
  )}
  {name === "sparkles" && (
    <>
      <path d="M26 6c1.3 7.4 4.6 10.7 12 12-7.4 1.3-10.7 4.6-12 12-1.3-7.4-4.6-10.7-12-12 7.4-1.3 10.7-4.6 12-12Z" />
      <path d="M12 28c.8 4.2 2.8 6.2 7 7-4.2.8-6.2 2.8-7 7-.8-4.2-2.8-6.2-7-7 4.2-.8 6.2-2.8 7-7Z" />
      <path d="M38 33v6M35 36h6" />
    </>
  )}
  {name === "calendar" && (
    <>
      <rect x="7" y="10" width="34" height="31" rx="4" />
      <path d="M16 6v8M32 6v8M7 19h34" />
    </>
  )}
  {name === "people" && (
    <>
      <circle cx="24" cy="15" r="6" />
      <path d="M13 40v-3c0-6 5-10 11-10s11 4 11 10v3" />
      <circle cx="11" cy="19" r="4" />
      <circle cx="37" cy="19" r="4" />
      <path d="M4 36v-2c0-4 3-7 7-7M44 36v-2c0-4-3-7-7-7" />
    </>
  )}
  {name === "person" && (
    <>
      <circle cx="24" cy="15" r="7" />
      <path d="M10 41v-3c0-7 6-12 14-12s14 5 14 12v3" />
    </>
  )}
  {name === "star" && (
    <path d="m24 6 5.5 11.2 12.4 1.8-9 8.7 2.1 12.3L24 34.2 12.9 40l2.2-12.3-9-8.7 12.4-1.8L24 6Z" />
  )}
  {name === "shield" && (
    <>
      <path d="M24 5 39 11v11c0 10-6.5 17-15 21-8.5-4-15-11-15-21V11l15-6Z" />
      <path d="m17 24 5 5 9-10" />
    </>
  )}
  {name === "leaf" && (
    <>
      <circle cx="24" cy="24" r="19" />
      <path d="M15 33c0-11 7-18 19-18 0 12-7 18-17 18" />
      <path d="M15 33 26 22" />
    </>
  )}
  {name === "play" && (
    <>
      <circle cx="24" cy="24" r="18" />
      <path d="m20 16 12 8-12 8V16Z" />
    </>
  )}
  {name === "chevron" && <path d="m19 14 10 10-10 10" />}
  {name === "arrow" && <path d="M8 24h32M30 14l10 10-10 10" />}
</svg>
