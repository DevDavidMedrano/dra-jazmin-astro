---
/**
 * Portada de Inicio ("Nuevo estilo"): fondo verde profundo, foto de la doctora
 * a la derecha con arco dorado y barra blanca con los 4 tratamientos abajo.
 */
import { withBase } from "../data/paths";
import Icon from "./Icon.astro";
import TreatmentStrip from "./TreatmentStrip.astro";
import iconSeguridad from "../assets/iconos/beneficio-seguridad.png";
import iconMedico from "../assets/iconos/beneficio-medico.png";
import iconNatural from "../assets/iconos/beneficio-natural.png";

// Dibujos dorados tomados de la imagen "Estilo".
const benefits = [
  { image: iconSeguridad, label: "Atención segura" },
  { image: iconMedico, label: "Enfoque médico" },
  { image: iconNatural, label: "Resultados naturales" },
];
---

<section class="home-hero" id="inicio">
  <figure class="home-hero-media">
    <img
      src={withBase("/images/doctora-inicio.webp")}
      alt="Dra. Jazmín Álvarez con bata médica"
      width="1066"
      height="1600"
      fetchpriority="high"
    />
  </figure>
  <span class="home-hero-arc" aria-hidden="true"></span>

  <div class="home-hero-content">
    <p class="eyebrow">Medicina estética y restauración capilar</p>
    <h1>
      Ciencia, estética y<br />
      salud capilar en<br />
      <em>un solo lugar</em>
    </h1>
    <p class="home-hero-description">
      Tratamientos personalizados que recuperan tu cabello, realzan tu belleza
      natural y fortalecen tu confianza.
    </p>

    <div class="hero-buttons">
      <a class="button button-gold button-large" href={withBase("/#agenda")}>
        <svg class="button-icon" viewBox="0 0 24 24" aria-hidden="true">
          <rect x="3.5" y="5.5" width="17" height="15" rx="2.5" />
          <path d="M8 3.5v4M16 3.5v4M3.5 10h17" />
        </svg>
        Agenda tu valoración
        <span class="cta-arrow" aria-hidden="true">→</span>
      </a>
      <a class="button button-outline button-large" href={withBase("/#tratamientos")}>
        <Icon name="play" class="button-icon" />
        Conoce los tratamientos
      </a>
    </div>

    <div class="hero-benefits" aria-label="Beneficios de la atención">
      {
        benefits.map((benefit) => (
          <div class="benefit">
            <span class="benefit-icon benefit-art">
              <img src={benefit.image.src} alt="" width={benefit.image.width} height={benefit.image.height} />
            </span>
            <p>{benefit.label}</p>
          </div>
        ))
      }
    </div>
  </div>

  <div class="home-hero-strip">
    <TreatmentStrip pictures />
  </div>
</section>
