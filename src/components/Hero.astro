---
import { withBase } from "../data/paths";
import { treatments } from "../data/site";
import Icon from "./Icon.astro";

const benefits = [
  { icon: "shield", label: "Enfoque médico" },
  { icon: "people", label: "Atención personalizada" },
  { icon: "leaf", label: "Resultados naturales" },
] as const;
---

<section class="hero" id="inicio">
  <div class="hero-content">
    <p class="eyebrow">Medicina estética y restauración capilar</p>
    <h1>
      Recupera tu cabello, renueva tu <em>confianza</em>
    </h1>
    <p class="hero-description">
      Tratamientos médicos especializados para la caída del cabello,
      rejuvenecimiento facial y bienestar estético.
    </p>

    <div class="hero-buttons">
      <a class="button button-gold button-large" href={withBase("/#agenda")}>
        <svg class="button-icon" viewBox="0 0 24 24" aria-hidden="true">
          <rect x="3.5" y="5.5" width="17" height="15" rx="2.5" />
          <path d="M8 3.5v4M16 3.5v4M3.5 10h17" />
        </svg>
        Agenda tu valoración
      </a>
      <a class="button button-outline button-large" href={withBase("/#tratamientos")}>
        <Icon name="play" class="button-icon" />
        Conoce los tratamientos
      </a>
    </div>

    <div class="hero-benefits" aria-label="Beneficios de la atención">
      {
        benefits.map((benefit) => (
          <div class="benefit">
            <span class="benefit-icon">
              <Icon name={benefit.icon} />
            </span>
            <p>{benefit.label}</p>
          </div>
        ))
      }
    </div>
  </div>

  <figure class="hero-media">
    <img
      src={withBase("/images/hero-doctor.webp")}
      alt="Dra. Jazmín Álvarez en su consultorio"
      width="842"
      height="605"
      fetchpriority="high"
    />
  </figure>

  <aside class="hero-treatments" aria-labelledby="hero-treatments-title">
    <h2 id="hero-treatments-title">Principales tratamientos</h2>
    <ul>
      {
        treatments.map((treatment) => (
          <li>
            <a href={withBase(`/#${treatment.id}`)}>
              <span class="hero-treatment-icon">
                <Icon name={treatment.icon} />
              </span>
              <span class="hero-treatment-title">{treatment.title}</span>
              <span class="hero-treatment-arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))
      }
    </ul>
  </aside>

  <svg class="hero-wave" viewBox="0 0 1440 90" preserveAspectRatio="none" aria-hidden="true">
    <path class="hero-wave-fill" d="M0 58C240 4 470 6 720 42s500 52 720 10V90H0Z" />
    <path class="hero-wave-line" d="M0 58C240 4 470 6 720 42s500 52 720 10" />
  </svg>
</section>

