---
import { site } from "../data/site";

const navItems = [
  { label: "Inicio", href: "/" },
  { label: "Tratamientos", href: "/tratamientos/" },
  { label: "Resultados", href: "/resultados/" },
  { label: "Sobre mí", href: "/sobre-mi/" },
  { label: "Blog", href: "/blog/" },
  { label: "Contacto", href: "/contacto/" },
  { label: "Instagram", href: site.instagramUrl, external: true },
];

const normalizePath = (path: string) => path.replace(/\/+$/, "") || "/";
const currentPath = normalizePath(Astro.url.pathname);
---

<header class="site-header" data-header>
  <a class="header-logo" href="/" aria-label="Ir al inicio">
    <img
      src="/brand/dra-jazmin-logo.png"
      alt="Dra. Jazmín Alvarez - Medicina estética y restauración capilar"
      width="1100"
      height="431"
    />
  </a>

  <nav class="desktop-nav" aria-label="Navegación principal">
    {
      navItems.map((item) => {
        const isActive = !item.external && normalizePath(item.href) === currentPath;

        return (
        <a
          class:list={["nav-link", { active: isActive }]}
          href={item.href}
          aria-current={isActive ? "page" : undefined}
          target={item.external ? "_blank" : undefined}
          rel={item.external ? "noreferrer" : undefined}
        >
          <span>{item.label}</span>
        </a>
        );
      })
    }
  </nav>

  <div class="header-actions">
    <a
      class="button button-outline whatsapp-button"
      href={site.whatsappUrl}
      target="_blank"
      rel="noreferrer"
      aria-label="Contactar por WhatsApp"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M20.5 11.6a8.5 8.5 0 0 1-12.6 7.5L3 20.5l1.3-4.8a8.5 8.5 0 1 1 16.2-4.1Z" />
        <path d="M8.1 7.7c.2-.5.5-.5.8-.5h.5c.2 0 .4 0 .6.5l.8 1.8c.1.3 0 .5-.1.7l-.6.8c-.2.2-.2.4 0 .7.5.9 1.3 1.7 2.3 2.2.3.2.5.1.7-.1l.9-1.1c.2-.3.5-.3.7-.2l1.8.9c.3.1.5.2.5.4 0 .2-.1 1.2-.6 1.7-.5.6-1.3.9-2.1.8-1.1-.1-2.6-.5-4.5-2.2-2.2-1.9-3.5-4.3-3.6-5.2 0-.6.1-.9.2-1.2Z" />
      </svg>
      WhatsApp
    </a>
    <a class="button button-dark header-appointment" href="/agenda/">
      <svg class="appointment-icon" viewBox="0 0 24 24" aria-hidden="true">
        <rect x="3.5" y="5.5" width="17" height="15" rx="2.5" />
        <path d="M8 3.5v4M16 3.5v4M3.5 10h17" />
      </svg>
      <span>Agenda tu valoración</span>
      <span class="cta-arrow" aria-hidden="true">→</span>
    </a>
  </div>

  <button
    class="menu-toggle"
    type="button"
    aria-label="Abrir menú"
    aria-expanded="false"
    data-menu-toggle
  >
    <span></span>
    <span></span>
  </button>

  <nav class="mobile-nav" aria-label="Navegación móvil" data-mobile-nav>
    {
      navItems.map((item) => {
        const isActive = !item.external && normalizePath(item.href) === currentPath;

        return (
        <a
          class:list={["mobile-link", { active: isActive }]}
          href={item.href}
          aria-current={isActive ? "page" : undefined}
          target={item.external ? "_blank" : undefined}
          rel={item.external ? "noreferrer" : undefined}
        >
          {item.label}
        </a>
        );
      })
    }
    <a
      class="mobile-whatsapp"
      href={site.whatsappUrl}
      target="_blank"
      rel="noreferrer"
    >
      WhatsApp
    </a>
    <a class="mobile-appointment" href="/agenda/">Agenda tu valoración</a>
  </nav>

  <div class="mobile-quick-actions" aria-label="Acciones rápidas">
    <a href={site.whatsappUrl} target="_blank" rel="noreferrer">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M20.5 11.6a8.5 8.5 0 0 1-12.6 7.5L3 20.5l1.3-4.8a8.5 8.5 0 1 1 16.2-4.1Z" />
        <path d="M8.1 7.7c.2-.5.5-.5.8-.5h.5c.2 0 .4 0 .6.5l.8 1.8c.1.3 0 .5-.1.7l-.6.8c-.2.2-.2.4 0 .7.5.9 1.3 1.7 2.3 2.2.3.2.5.1.7-.1l.9-1.1c.2-.3.5-.3.7-.2l1.8.9c.3.1.5.2.5.4 0 .2-.1 1.2-.6 1.7-.5.6-1.3.9-2.1.8-1.1-.1-2.6-.5-4.5-2.2-2.2-1.9-3.5-4.3-3.6-5.2 0-.6.1-.9.2-1.2Z" />
      </svg>
      WhatsApp
    </a>
    <a href="/agenda/">
      <span aria-hidden="true">▦</span>
      Agendar cita
    </a>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const mobileNav = document.querySelector<HTMLElement>("[data-mobile-nav]");

  const closeMenu = () => {
    toggle?.setAttribute("aria-expanded", "false");
    toggle?.setAttribute("aria-label", "Abrir menú");
    mobileNav?.classList.remove("open");
    document.body.classList.remove("menu-open");
  };

  toggle?.addEventListener("click", () => {
    const isOpen = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!isOpen));
    toggle.setAttribute("aria-label", isOpen ? "Abrir menú" : "Cerrar menú");
    mobileNav?.classList.toggle("open", !isOpen);
    document.body.classList.toggle("menu-open", !isOpen);

    if (!isOpen) {
      mobileNav?.querySelector<HTMLAnchorElement>("a")?.focus();
    }
  });

  mobileNav?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", closeMenu);
  });

  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape" || toggle?.getAttribute("aria-expanded") !== "true") return;
    closeMenu();
    toggle?.focus();
  });

  window.addEventListener("resize", () => {
    if (window.innerWidth > 1380) closeMenu();
  });
</script>
