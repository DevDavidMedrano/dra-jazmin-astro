---
import { stripBase, withBase } from "../data/paths";
import { site, treatments } from "../data/site";
import BrandLogo from "./BrandLogo.astro";
import Icon from "./Icon.astro";
import logoEstilo from "../assets/logo-estilo.png";

/** `section` es el id de la sección en la página única. */
const sectionLink = (label: string, section: string, extra: object = {}) => ({
  label,
  section,
  href: withBase(`/#${section}`),
  ...extra,
});

const navItems: {
  label: string;
  href: string;
  section?: string;
  external?: boolean;
  children?: typeof treatments;
}[] = [
  sectionLink("Inicio", "inicio"),
  sectionLink("Tratamientos", "tratamientos", { children: treatments }),
  sectionLink("Resultados", "resultados"),
  sectionLink("Sobre mí", "sobre-mi"),
  sectionLink("Blog", "blog"),
  sectionLink("Contacto", "contacto"),
  { label: "Instagram", href: site.instagramUrl, external: true },
];

// En la página única el enlace activo lo actualiza el script según la sección visible.
// En las páginas sueltas (/tratamientos/, /blog/…) se marca el apartado correspondiente.
const currentPath = stripBase(Astro.url.pathname);
const isActive = (item: (typeof navItems)[number]) => {
  if (item.external || !item.section) return false;
  return currentPath === "/" ? item.section === "inicio" : currentPath === `/${item.section}`;
};
---

<header class="site-header" data-header>
  <a class="header-logo" href={withBase("/")} aria-label={`${site.doctorName} - Ir al inicio`}>
    {
      currentPath === "/" ? (
        <img class="header-logo-estilo" src={logoEstilo.src} alt={site.doctorName} width={logoEstilo.width} height={logoEstilo.height} />
      ) : (
        <BrandLogo variant="light" />
      )
    }
  </a>

  <nav class="desktop-nav" aria-label="Navegación principal">
    {
      navItems.map((item) =>
        item.children ? (
          <div class="nav-dropdown">
            <a
              class:list={["nav-link", "nav-link-parent", { active: isActive(item) }]}
              href={item.href}
              aria-current={isActive(item) ? "page" : undefined}
              aria-haspopup="true"
            >
              <span>{item.label}</span>
              <svg class="nav-caret" viewBox="0 0 12 12" aria-hidden="true">
                <path d="m3 4.5 3 3 3-3" />
              </svg>
            </a>
            <div class="nav-submenu">
              {item.children.map((child) => (
                <a href={withBase(`/#${child.id}`)}>
                  <span class="nav-submenu-icon">
                    <Icon name={child.icon} />
                  </span>
                  {child.title}
                </a>
              ))}
            </div>
          </div>
        ) : (
          <a
            class:list={["nav-link", { active: isActive(item), "nav-link-external": item.external }]}
            href={item.href}
            aria-current={isActive(item) ? "page" : undefined}
            target={item.external ? "_blank" : undefined}
            rel={item.external ? "noreferrer" : undefined}
          >
            <span>{item.label}</span>
          </a>
        ),
      )
    }
  </nav>

  <div class="header-actions">
    <a
      class="button button-outline whatsapp-button"
      href={site.whatsappUrl}
      target="_blank"
      rel="noreferrer"
      aria-label="Contactar por WhatsApp"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M20.5 11.6a8.5 8.5 0 0 1-12.6 7.5L3 20.5l1.3-4.8a8.5 8.5 0 1 1 16.2-4.1Z" />
        <path d="M8.1 7.7c.2-.5.5-.5.8-.5h.5c.2 0 .4 0 .6.5l.8 1.8c.1.3 0 .5-.1.7l-.6.8c-.2.2-.2.4 0 .7.5.9 1.3 1.7 2.3 2.2.3.2.5.1.7-.1l.9-1.1c.2-.3.5-.3.7-.2l1.8.9c.3.1.5.2.5.4 0 .2-.1 1.2-.6 1.7-.5.6-1.3.9-2.1.8-1.1-.1-2.6-.5-4.5-2.2-2.2-1.9-3.5-4.3-3.6-5.2 0-.6.1-.9.2-1.2Z" />
      </svg>
      WhatsApp
    </a>
    <a class="button button-dark header-appointment" href={withBase("/#agenda")}>
      <svg class="appointment-icon" viewBox="0 0 24 24" aria-hidden="true">
        <rect x="3.5" y="5.5" width="17" height="15" rx="2.5" />
        <path d="M8 3.5v4M16 3.5v4M3.5 10h17" />
      </svg>
      <span>Agenda tu valoración</span>
      <span class="cta-arrow" aria-hidden="true">→</span>
    </a>
  </div>

  <button
    class="menu-toggle"
    type="button"
    aria-label="Abrir menú"
    aria-expanded="false"
    data-menu-toggle
  >
    <span></span>
    <span></span>
  </button>

  <nav class="mobile-nav" aria-label="Navegación móvil" data-mobile-nav>
    {
      navItems.map((item) => (
        <>
          <a
            class:list={["mobile-link", { active: isActive(item) }]}
            href={item.href}
            aria-current={isActive(item) ? "page" : undefined}
            target={item.external ? "_blank" : undefined}
            rel={item.external ? "noreferrer" : undefined}
          >
            {item.label}
          </a>
          {item.children && (
            <div class="mobile-sublinks">
              {item.children.map((child) => (
                <a href={withBase(`/#${child.id}`)}>{child.title}</a>
              ))}
            </div>
          )}
        </>
      ))
    }
    <a class="mobile-whatsapp" href={site.whatsappUrl} target="_blank" rel="noreferrer">
      WhatsApp
    </a>
    <a class="mobile-appointment" href={withBase("/#agenda")}>Agenda tu valoración</a>
  </nav>
</header>

<!--
  Fuera de <header>: la cabecera usa backdrop-filter, que convierte a la cabecera
  en el contenedor de los elementos "fixed" y hacía que esta barra apareciera
  arriba, tapando el logo y el menú en celulares.
-->
<div class="mobile-quick-actions" aria-label="Acciones rápidas">
  <a href={site.whatsappUrl} target="_blank" rel="noreferrer">
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M20.5 11.6a8.5 8.5 0 0 1-12.6 7.5L3 20.5l1.3-4.8a8.5 8.5 0 1 1 16.2-4.1Z" />
      <path d="M8.1 7.7c.2-.5.5-.5.8-.5h.5c.2 0 .4 0 .6.5l.8 1.8c.1.3 0 .5-.1.7l-.6.8c-.2.2-.2.4 0 .7.5.9 1.3 1.7 2.3 2.2.3.2.5.1.7-.1l.9-1.1c.2-.3.5-.3.7-.2l1.8.9c.3.1.5.2.5.4 0 .2-.1 1.2-.6 1.7-.5.6-1.3.9-2.1.8-1.1-.1-2.6-.5-4.5-2.2-2.2-1.9-3.5-4.3-3.6-5.2 0-.6.1-.9.2-1.2Z" />
    </svg>
    WhatsApp
  </a>
  <a href={withBase("/#agenda")}>
    <span aria-hidden="true">▦</span>
    Agendar cita
  </a>
</div>

<script>
  import { stripBase } from "../data/paths";

  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const mobileNav = document.querySelector<HTMLElement>("[data-mobile-nav]");

  const closeMenu = () => {
    toggle?.setAttribute("aria-expanded", "false");
    toggle?.setAttribute("aria-label", "Abrir menú");
    mobileNav?.classList.remove("open");
    document.body.classList.remove("menu-open");
  };

  toggle?.addEventListener("click", () => {
    const isOpen = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!isOpen));
    toggle.setAttribute("aria-label", isOpen ? "Abrir menú" : "Cerrar menú");
    mobileNav?.classList.toggle("open", !isOpen);
    document.body.classList.toggle("menu-open", !isOpen);

    if (!isOpen) {
      mobileNav?.querySelector<HTMLAnchorElement>("a")?.focus();
    }
  });

  mobileNav?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", closeMenu);
  });

  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape" || toggle?.getAttribute("aria-expanded") !== "true") return;
    closeMenu();
    toggle?.focus();
  });

  window.addEventListener("resize", () => {
    if (window.innerWidth > 1100) closeMenu();
  });

  // Página única: marca en el menú la sección que se está viendo.
  if (stripBase(window.location.pathname) === "/") {
    const links = Array.from(
      document.querySelectorAll<HTMLAnchorElement>(
        ".desktop-nav .nav-link[href*='#'], .mobile-nav .mobile-link[href*='#']",
      ),
    );
    // Todas las secciones principales, aunque no tengan botón en el menú (p. ej. Agenda),
    // para que el menú no marque la sección anterior mientras se ve otra.
    const sections = Array.from(document.querySelectorAll<HTMLElement>("main > [id]"));

    const setActive = (id: string) => {
      links.forEach((link) => {
        const active = link.hash === `#${id}`;
        link.classList.toggle("active", active);
        if (active) link.setAttribute("aria-current", "location");
        else link.removeAttribute("aria-current");
      });
    };

    const updateActive = () => {
      const offset = window.innerHeight * 0.35;
      let current = "inicio";
      for (const section of sections) {
        if (section.getBoundingClientRect().top - offset <= 0) current = section.id;
      }
      setActive(current);
    };

    let ticking = false;
    window.addEventListener(
      "scroll",
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          updateActive();
          ticking = false;
        });
      },
      { passive: true },
    );
    updateActive();
  }
</script>

<script>
  // En Inicio, mientras se ve la portada, el encabezado es transparente y se funde con el fondo.
  const header = document.querySelector<HTMLElement>("[data-header]");
  const homeHero = document.querySelector<HTMLElement>(".home-hero");

  if (header && homeHero) {
    document.documentElement.classList.add("has-home-hero");
    const update = () => header.classList.toggle("header-over-hero", window.scrollY < 24);
    update();
    window.addEventListener("scroll", update, { passive: true });
  }
</script>
