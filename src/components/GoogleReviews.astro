---
/** Opiniones de 5 estrellas de Google (sección de Contacto). */
import { googleReviews } from "../data/site";

const stars = "★★★★★";
---

<section class="greviews" aria-labelledby="greviews-heading">
  <div class="greviews-head">
    <p class="greviews-eyebrow">Opiniones en Google</p>
    <h2 id="greviews-heading">Lo que dicen <em>nuestros pacientes</em></h2>
    <div class="greviews-score">
      <span class="greviews-g" aria-hidden="true">
        <svg viewBox="0 0 48 48"><path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3l5.7-5.7C34 6.1 29.3 4 24 4 13 4 4 13 4 24s9 20 20 20 20-9 20-20c0-1.3-.1-2.4-.4-3.5Z"/><path fill="#FF3D00" d="m6.3 14.7 6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7Z"/><path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-7.9l-6.5 5C9.5 39.6 16.2 44 24 44Z"/><path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.4-.4-3.5Z"/></svg>
      </span>
      <strong>{googleReviews.rating}</strong>
      <span class="greviews-stars" aria-label="5 de 5 estrellas">{stars}</span>
      <span>{googleReviews.count} opiniones</span>
    </div>
  </div>

  <ul class="greviews-list">
    {googleReviews.items.map((r) => (
      <li class="greview">
        <div class="greview-top">
          <span class="greview-avatar" aria-hidden="true">{r.name.charAt(0)}</span>
          <div>
            <strong>{r.name}</strong>
            <span class="greview-meta"><span class="greviews-stars" aria-label="5 estrellas">{stars}</span> {r.when}</span>
          </div>
        </div>
        <p>“{r.text}”</p>
      </li>
    ))}
  </ul>

  <a class="greviews-link" href={googleReviews.url} target="_blank" rel="noreferrer">
    Ver todas las opiniones en Google <span aria-hidden="true">↗</span>
  </a>
</section>
