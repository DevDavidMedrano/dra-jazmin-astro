---
import { withBase } from "../data/paths";
import { credentials, site } from "../data/site";
import BrandLogo from "./BrandLogo.astro";
---

<footer class="global-footer">
  <div class="footer-brand">
    <BrandLogo variant="light" />
    <p>Medicina estética y restauración capilar con atención personalizada.</p>
  </div>

  <div class="footer-column">
    <p class="footer-label">Contacto</p>
    <a href={site.whatsappUrl} target="_blank" rel="noreferrer">
      {site.whatsappDisplay}
    </a>
    <a href={site.mapsUrl} target="_blank" rel="noreferrer">
      {site.clinic}
    </a>
    <span>Atención con cita previa</span>
  </div>

  <nav class="footer-column footer-nav" aria-label="Navegación del pie de página">
    <p class="footer-label">Explora</p>
    <a href={withBase("/#tratamientos")}>Tratamientos</a>
    <a href={withBase("/#resultados")}>Resultados</a>
    <a href={withBase("/#sobre-mi")}>Sobre mí</a>
    <a href={withBase("/#blog")}>Blog</a>
    <a href={withBase("/#contacto")}>Contacto</a>
  </nav>

  <div class="footer-social">
    <p class="footer-label">Síguenos</p>
    <a
      class="footer-instagram"
      href={site.instagramUrl}
      target="_blank"
      rel="noreferrer"
      aria-label={`Abrir Instagram ${site.instagramHandle}`}
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <rect x="3" y="3" width="18" height="18" rx="5" />
        <circle cx="12" cy="12" r="4" />
        <circle cx="17.4" cy="6.7" r=".8" class="instagram-dot" />
      </svg>
      <span>
        Instagram
        <small>{site.instagramHandle}</small>
      </span>
      <b aria-hidden="true">↗</b>
    </a>
    <a class="footer-agenda" href={withBase("/#agenda")}>Agenda tu valoración</a>
  </div>

  <div class="footer-legal">
    <span>© 2026 Dra. Jazmín Álvarez.</span>
    <span>{credentials.fullName} · Céd. Prof. {credentials.cedula}</span>
    <span data-footer-cofepris>COFEPRIS: {credentials.cofepris}</span>
    <span>La información del sitio no sustituye una valoración médica.</span>
    <a href={withBase("/admin/login/")}>Acceso administrativo</a>
    <a class="footer-privacy" href={withBase("/aviso-de-privacidad/")}>Aviso de privacidad</a>
  </div>
</footer>

<script>
  import { getDemoSettings } from "../scripts/demoStore";

  const cofepris = document.querySelector<HTMLElement>("[data-footer-cofepris]");
  if (cofepris) cofepris.textContent = getDemoSettings().cofepris;
</script>
