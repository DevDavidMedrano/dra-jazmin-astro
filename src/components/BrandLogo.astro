---
import { withBase } from "../data/paths";
/**
 * Logotipo oficial (símbolo + "Dra. Jazmín Álvarez" + especialidad).
 * La variante "light" lo invierte a blanco para los fondos oscuros.
 */
import { site } from "../data/site";

interface Props {
  variant?: "dark" | "light";
  class?: string;
}

const { variant = "dark", class: className } = Astro.props;
---

<span class:list={["brand-logo", `brand-logo-${variant}`, className]}>
  <img
    class="brand-logo-full"
    src={withBase("/brand/dra-jazmin-logo.png")}
    alt={`${site.doctorName} · ${site.specialty}`}
    width="1100"
    height="431"
  />
</span>
