---
const services = [
  {
    title: "Injerto capilar",
    description:
      "Soluciones avanzadas para la restauración capilar con un diseño natural y personalizado.",
    icon: "hair",
    href: "/tratamientos/#injerto-capilar",
  },
  {
    title: "Medicina estética",
    description:
      "Tratamientos médico-estéticos para rejuvenecer, armonizar y cuidar tu imagen.",
    icon: "syringe",
    href: "/tratamientos/#medicina-estetica",
  },
  {
    title: "Valoración personalizada",
    description:
      "Evaluación médica integral para diseñar un plan de tratamiento a tu medida.",
    icon: "profile",
    href: "/agenda/",
  },
];
---

<section class="service-section" id="tratamientos">
  <div class="service-grid">
    {
      services.map((service) => (
        <a class="service-card" href={service.href} aria-label={`Conocer más sobre ${service.title}`}>
          <div class="service-icon" aria-hidden="true">
            {service.icon === "hair" && (
              <svg viewBox="0 0 48 48">
                <path d="M5 31h38M9 25h30M14 19h20" />
                <path d="M24 6c-7 7-9 15-6 24 1.5 4.8 4.2 8 6 10 1.8-2 4.5-5.2 6-10 3-9-1-17-6-24Z" />
                <path d="M24 16c-3 5-3 10 0 15 3-5 3-10 0-15Z" />
              </svg>
            )}
            {service.icon === "syringe" && (
              <svg viewBox="0 0 48 48">
                <path d="m12 36 22-22M29 9l10 10M25 13l10 10M8 40l7-2-5-5-2 7ZM17 31 8 22M14 19l15 15M31 8l5-5M40 12l5-5" />
              </svg>
            )}
            {service.icon === "profile" && (
              <svg viewBox="0 0 48 48">
                <rect x="10" y="10" width="28" height="32" rx="3" />
                <path d="M19 10V7h10v3M17 36c1-5 4-8 7-8s6 3 7 8M24 17a5 5 0 1 1 0 10 5 5 0 0 1 0-10Z" />
              </svg>
            )}
          </div>

          <div class="service-copy">
            <h2>{service.title}</h2>
            <p>{service.description}</p>
          </div>

          <span class="service-arrow" aria-hidden="true">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="m9 5 7 7-7 7" />
            </svg>
          </span>
        </a>
      ))
    }
  </div>
</section>
