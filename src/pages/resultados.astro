---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import SiteFooter from "../components/SiteFooter.astro";
import InnerHero from "../components/InnerHero.astro";
import ResultsGallerySection from "../components/sections/ResultsGallerySection.astro";
---

<BaseLayout
  title="Resultados | Dra. Jazmín Álvarez"
  description="Consulta la estructura de la galería clínica y conoce cómo se documenta la evolución de cada tratamiento."
>
  <Header />
  <main class="inner-page">
    <InnerHero
      eyebrow="Resultados"
      title="Resultados que se sienten naturales"
      description="Cada proceso es único y se acompaña de una valoración profesional, seguimiento y documentación responsable."
      image="/images/hero-doctor-02.webp"
      imageAlt="Dra. Jazmín Álvarez en su consultorio"
    />
    <ResultsGallerySection />
    <section class="page-cta page-cta-compact">
      <div>
        <p class="eyebrow eyebrow-light">Tu caso es único</p>
        <h2>Conoce qué opciones pueden ser adecuadas para ti.</h2>
      </div>
      <a class="button button-light button-large" href="/#agenda">Agenda una valoración</a>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
