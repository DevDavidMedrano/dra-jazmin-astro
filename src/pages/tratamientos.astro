---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import TreatmentsSection from "../components/sections/TreatmentsSection.astro";
import SiteFooter from "../components/SiteFooter.astro";
---

<BaseLayout
  title="Tratamientos | Dra. Jazmín Álvarez"
  description="Conoce las opciones de restauración capilar, rejuvenecimiento facial, medicina estética y tratamientos personalizados."
>
  <Header />
  <main class="inner-page treatments-page">
    <TreatmentsSection />

    <section class="page-cta">
      <div>
        <p class="eyebrow eyebrow-light">Tu siguiente paso</p>
        <h2>Encuentra el tratamiento adecuado para ti.</h2>
      </div>
      <a class="button button-light button-large" href="/#agenda">Agenda una valoración</a>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
