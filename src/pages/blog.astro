---
import { withBase } from "../data/paths";
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import SiteFooter from "../components/SiteFooter.astro";
import BlogSection from "../components/sections/BlogSection.astro";
---

<BaseLayout
  title="Blog y presentación | Dra. Jazmín Álvarez"
  description="Conoce el enfoque, experiencias y recomendaciones de la Dra. Jazmín Álvarez sobre restauración capilar y medicina estética."
>
  <Header />
  <main class="inner-page">
    <BlogSection />
    <section class="page-cta page-cta-compact">
      <div>
        <p class="eyebrow eyebrow-light">Atención personalizada</p>
        <h2>La información ayuda; la valoración define tu plan.</h2>
      </div>
      <a class="button button-light button-large" href={withBase("/#agenda")}>Agenda tu valoración</a>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
