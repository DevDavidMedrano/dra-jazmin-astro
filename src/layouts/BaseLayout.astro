---
import { withBase } from "../data/paths";
import "../styles/global.css";
import "../styles/pages.css";
import "../styles/redesign.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Dra. Jazmín Álvarez | Restauración capilar",
  description = "Medicina estética y restauración capilar con atención personalizada, valoración médica y seguimiento cercano.",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta name="format-detection" content="telephone=no" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0B3D31" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={withBase("/og.png")} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={withBase("/og.png")} />

    <link rel="icon" type="image/png" href={withBase("/brand/dra-jazmin-mark.png")} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
